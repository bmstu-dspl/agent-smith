# Public deployment settings. Copy to .env and replace values.
APP_DOMAIN=bot.example.com
LOG_LEVEL=INFO

# Non-secret PostgreSQL settings.
POSTGRES_DB=agent_smith
POSTGRES_USER=agent_smith
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Secret files are mounted by Docker Compose.
SECRETS_DIR=./secrets

# Optional dev profile only.
NGROK_AUTHTOKEN=
