# Public deployment settings. Copy to .env and replace values.
APP_DOMAIN=bot.example.com
LOG_LEVEL=INFO

# Non-secret PostgreSQL settings.
POSTGRES_DB=agent_smith
POSTGRES_USER=agent_smith
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Shared Vertex AI service account for AI agent and RAG.
# Host path to the complete JSON. Docker mounts it into both services.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google_service_account.json
# Required by the AI agent; copy project_id from the service account JSON.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# AI agent.
LLM_PROVIDER=google_vertex
LLM_MODEL=gemini-2.5-flash

# RAG query extractor LLM. Uses cheaper Gemini Flash Lite by default.
# Set RAG_EXTRACTOR_LLM_PROVIDER=same to reuse the main agent LLM.
RAG_EXTRACTOR_LLM_PROVIDER=google_vertex
RAG_EXTRACTOR_LLM_MODEL=gemini-2.5-flash-lite

# RAG embeddings. Separate location avoids changing the AI agent location.
GOOGLE_EMBEDDING_LOCATION=us-central1
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_EMBEDDING_DIMENSIONS=1536
GOOGLE_EMBEDDING_TIMEOUT=30
GOOGLE_EMBEDDING_MAX_RETRIES=3

# Secret files are mounted by Docker Compose.
SECRETS_DIR=./secrets

# Optional dev profile only.
NGROK_AUTHTOKEN=

# Ключ шифрования (требуется генерация, см. mcp_registry/README.md)
MCP_SECRETS_ENCRYPTION_KEY=your_generated_fernet_key_here
