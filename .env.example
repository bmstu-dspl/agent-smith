# Скопируйте этот файл в новый файл ".env" и заполните реальными значениями:
# cp .env.example .env
# Файл ".env" никогда не коммитится (.gitignore) - здесь только примеры.

# Telegram Bot
BOT_TOKEN=123456789:AAExampleTokenReplaceWithReal

# База данных (Postgres)
POSTGRES_DB=agent_smith
POSTGRES_USER=agent_smith
POSTGRES_PASSWORD=change_me

# Ссылки
HOTEL_BOOKING_SITE_URL=https://your-hotel-site.ru/booking