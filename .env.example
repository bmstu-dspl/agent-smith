# Скопируйте этот файл в новый файл ".env" и заполните реальными значениями:
# cp .env.example .env
# Файл ".env" никогда не коммитится (.gitignore) - здесь только примеры.

# Telegram Bot
BOT_TOKEN=123456789:AAExampleTokenReplaceWithReal

# Agent
LLM_PROVIDER=google_vertex
LLM_MODEL=gemini-2.5-flash

GOOGLE_CLOUD_PROJECT=agent-smith-501607
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./vertex-ai-service-account.json
GOOGLE_GENAI_USE_VERTEXAI=true

# База данных (Postgres)
POSTGRES_DB=agent_smith
POSTGRES_USER=agent_smith
POSTGRES_PASSWORD=change_me
