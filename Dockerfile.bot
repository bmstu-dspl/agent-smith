FROM python:3.14-slim

WORKDIR /app

# Установка uv
COPY --from=ghcr.io/astral-sh/uv:0.11.25 /uv /uvx /bin/

# Копируем зависимости
COPY pyproject.toml uv.lock ./

# Устанавливаем зависимости
RUN uv sync --no-dev --frozen

# Копируем код
COPY . .

ENV PYTHONPATH=/app

CMD ["uv", "run", "python", "run.py"]
