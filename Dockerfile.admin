FROM python:3.14-slim

WORKDIR /app

# Установка uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Копируем файлы зависимостей (единый lock-файл на весь монорепозиторий)
COPY pyproject.toml uv.lock ./

RUN uv sync --no-dev --frozen && \
    uv pip install redis>=5.0.0 starlette-admin==0.17.0 bcrypt>=4.0.0

# Копируем только то, что реально нужно админке
COPY admin_panel/ admin_panel/
COPY shared/ shared/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8001

CMD ["uv", "run", "uvicorn", "admin_panel.app:app", "--host", "0.0.0.0", "--port", "8001"]